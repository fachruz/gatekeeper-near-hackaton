[0.61152, "o", "╔══════════════════════════════════════════════════════════════════╗\r\n"]
[0.614741, "o", "║  GATEKEEPER — live attack demo on NEAR testnet                   ║\r\n║  A prompt-injected AI agent tries to pay the wrong people.       ║\r\n║  Its money sits behind an on-chain policy firewall.              ║\r\n╚══════════════════════════════════════════════════════════════════╝\r\n\r\n■ SETUP — fresh demo state (nothing reused from earlier runs)\r\n"]
[0.739811, "o", "  · creating fresh demo accounts under gatekeeper-dev-1e0e16a9.testnet (run bzsn5v)\r\n"]
[12.582321, "o", "    created agent-bzsn5v.gatekeeper-dev-1e0e16a9.testnet (funded 0.25 NEAR) — tx 9mFBBWYHtAHqN93sbotXDEyEgybkcaJ7qFvRACUi84HS\r\n"]
[30.599955, "o", "    created shop-bzsn5v.gatekeeper-dev-1e0e16a9.testnet (funded 0.03 NEAR) — tx 66CgdKdJzk6U98bpwCPEAynFnvTeJHcXrw2qhdi6BRW2\r\n"]
[49.055948, "o", "    created drainer-bzsn5v.gatekeeper-dev-1e0e16a9.testnet (funded 0.03 NEAR) — tx Bqs7sczkhP72iKeRshMLmj9bXQ2ajKnwyHRZWzYUob6q\r\n"]
[60.108683, "o", "    function-call key issued to the agent (pay on gatekeeper.gatekeeper-dev-1e0e16a9.testnet only, 0.05 NEAR allowance) — tx JDutcuBC1SVT9VtwCfeHVcZKQjN7CE88Ywk5ajJ6gAWj\r\n"]
[78.627609, "o", "    policy registered: per-tx cap 0.1 NEAR, daily cap 0.2 NEAR, human approval above 0.04 NEAR — tx AQaNx5WVuxUdhMJ8uv99bdpTkqVUeyYbAMHvBokH61WV\r\n"]
