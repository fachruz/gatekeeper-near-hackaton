# Copy to .env and fill locally. NEVER commit a filled .env.
# Testnet only for the hackathon build.

# Deployed Gatekeeper contract on NEAR testnet
CONTRACT_ID=gatekeeper.gatekeeper-dev-1e0e16a9.testnet

# --- Live demo (demo:live / setup:demo) ---
# ONE faucet-funded testnet account is all the demo setup needs: every
# other account (agent, merchant, drainer, reporters) is created fresh
# under it on each run. Give EITHER the two vars below OR a credentials
# file in the near-cli export format via GK_CREDS_FILE.
OPERATOR_ACCOUNT_ID=
OPERATOR_PRIVATE_KEY=
# GK_CREDS_FILE=/path/to/near-testnet-dev-account.txt
# GK_OPERATOR_ACCOUNT=gatekeeper-dev-1e0e16a9.testnet

# Optional overrides
# NEAR_RPC_URL=https://rpc.testnet.near.org
# NEARBLOCKS_API_URL=https://testnet.nearblocks.io/api/v1
# GK_PACE=0
# NEAR_AI_API_KEY=
